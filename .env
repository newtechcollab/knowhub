# OpenAI-compatible proxy
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Salesforce
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_USERNAME=your-salesforce-user-name
SALESFORCE_PRIVATE_KEY_PATH=path-to-server.key-file
SALESFORCE_API_VERSION=v66.0

# ServiceNow
SERVICENOW_INSTANCE=https://your-instance-name.service-now.com
SERVICENOW_CLIENT_ID=your-servicenow-client-id
SERVICENOW_CLIENT_SECRET=your-servicenow-client-secret
#SERVICENOW_USERNAME=your-user-name
#SERVICENOW_PASSWORD=your-password

# Jira and Confluence
JIRA_BASE_URL=https://your-base-url-name.atlassian.net
CONFLUENCE_BASE_URL=https://your-base-url-name.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email
CONFLUENCE_API_TOKEN=your-api-token

# Application
KNOWLEDGE_HUB_HMAC_SECRET=replace_with_a_secure_random_secret
